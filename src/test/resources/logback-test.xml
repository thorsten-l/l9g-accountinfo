  Logging während der Tests.

  Die Suite provoziert Fehlerpfade absichtlich — versiegelter Vault, nicht
  erreichbare Datenbank, verfälschte Signaturen, replayte Requests, abgebrochene
  WebSocket-Verbindungen. Der Produktivcode loggt diese Fälle korrekterweise auf
  ERROR, teils mit vollem Stacktrace. In der Testausgabe erzeugt das hunderte
  Zeilen, die wie Fehler aussehen, obwohl jeder davon ein bestandener Test ist.

  Die Anwendungs-Logger sind hier daher stumm. Was ein Test prüft, steht in
  seinen Assertions, nicht im Log.

  Beim Debuggen eines fehlschlagenden Tests lässt sich das Log gezielt
  wieder einschalten:

      mvn test -Dtest=VaultServiceTest -Dtest.log.level=DEBUG

  Nur für Tests wirksam. Das Produktiv-Logging wird über application.yaml
  konfiguriert und ist davon nicht berührt.
-->
<configuration>

  <!-- Überschreibbar per -Dtest.log.level=DEBUG|INFO|WARN|ERROR|OFF -->
  <property name="APP_LOG_LEVEL" value="${test.log.level:-OFF}"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Die Anwendung selbst -->
  <logger name="l9g.account.info" level="${APP_LOG_LEVEL}"/>

  <!-- Die L9G-Crypto-Bibliothek loggt fehlgeschlagene Entschlüsselungen,
       die von tamperedCiphertextIsRejected bewusst ausgelöst werden. -->
  <logger name="de.l9g.crypto" level="${APP_LOG_LEVEL}"/>

  <!-- Der In-Memory-Verzeichnisserver in LdapServiceInjectionTest -->
  <logger name="com.unboundid" level="WARN"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>
